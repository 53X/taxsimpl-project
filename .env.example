# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Verified sender on your Resend domain (e.g. TaxSimpl <hello@taxsimpl.com>)
RESEND_FROM_EMAIL=TaxSimpl <hello@taxsimpl.com>

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=info@taxsimpl.com

# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-11

# Admin-only Studio access (Basic Auth)
# Used by `middleware.ts` to protect /studio from public access.
STUDIO_BASIC_AUTH_USER=admin
STUDIO_BASIC_AUTH_PASS=change_me
